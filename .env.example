# Copie para .env (fora do git) e preencha antes de subir em produção.

# Chave de assinatura de cookies/flash do Trilha. Gere com: trilha secret
TRILHA_SECRET=

# Agent ID do agente publicado na ElevenLabs (identificador público do
# widget; a credencial fica no painel da ElevenLabs, nunca aqui).
ELEVENLABS_AGENT_ID=

# Diretório dos dados de atendimento (JSON). Use um volume persistente na VPS.
DATA_DIR=data
