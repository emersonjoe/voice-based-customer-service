# Copie para .env (fora do git) e preencha antes de subir em produção.

# Chave de assinatura de cookies/flash do Trilha. Gere com: trilha secret
TRILHA_SECRET=

# Agent ID do agente publicado na ElevenLabs (identificador público do
# widget; a credencial fica no painel da ElevenLabs, nunca aqui).
ELEVENLABS_AGENT_ID=

# Chave de API da ElevenLabs — SÓ do servidor, nunca do navegador. Exigida
# quando o agente é privado (autenticação habilitada): é com ela que o
# servidor assina a URL de sessão que o widget usa.
ELEVENLABS_API_KEY=

# Cartesia (provedor alternativo de voz). A chave fica SÓ no servidor:
# é ela que cunha os access tokens de curta vida que o widget usa.
CARTESIA_API_KEY=
# Agent ID do Managed Agent criado em play.cartesia.ai/agents
CARTESIA_AGENT_ID=
# Agent ID do Guia Matarazzo (concierge da POC) na Cartesia
MATARAZZO_AGENT_ID=
# Guia Matarazzo na ElevenLabs (mesmo concierge, segundo provedor)
ELEVENLABS_MATARAZZO_AGENT_ID=

# Diretório dos dados de atendimento (JSON). Use um volume persistente na VPS.
DATA_DIR=data
